# ─── Base de datos ───────────────────────────────────────────────────────────
# Usada por application-local.yml (dev local sin Docker)
DB_URL=jdbc:postgresql://localhost:5433/mentoredu_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Variables del servicio postgres en docker-compose.yml
POSTGRES_DB=mentoredu_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ─── JWT ────────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres para HS256. OBLIGATORIO cambiar en producción.
JWT_SECRET=cambia-esto-a-un-secreto-largo-y-seguro-minimo-32-chars
JWT_EXPIRATION=86400000

# ─── PgAdmin ─────────────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@mentoredu.com
PGADMIN_PASSWORD=admin
