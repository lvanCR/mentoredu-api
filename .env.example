# ─── Perfil activo ────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local

# ─── Base de datos ────────────────────────────────────────────────────────────
# Puerto 5433: compose.yml mapea 5433:5432 (PostgreSQL en Docker)
DB_URL=jdbc:postgresql://localhost:5433/mentoredu
DB_USERNAME=mentoredu
DB_PASSWORD=mentoredu

# Variables usadas por el servicio postgres en compose.yml
POSTGRES_DB=mentoredu
POSTGRES_USER=mentoredu
POSTGRES_PASSWORD=mentoredu

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres para HS256. OBLIGATORIO cambiar en producción.
# En local, application-local.yml provee un valor por defecto — esta variable
# es opcional para el perfil local pero obligatoria en producción.
JWT_SECRET=
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ─── Archivos ─────────────────────────────────────────────────────────────────
FILE_UPLOAD_DIR=uploads/resources
FILE_MAX_SIZE_MB=20

# ─── PgAdmin (UI en http://localhost:8082) ────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@mentoredu.com
PGADMIN_DEFAULT_PASSWORD=admin

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_BASE_URL=http://localhost:4200

# ─── Spring AI / OpenAI ───────────────────────────────────────────────────────
# Obtener en: https://platform.openai.com/api-keys
OPENAI_API_KEY=
