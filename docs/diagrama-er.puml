@startuml
title Diagrama ER Físico\nMentorEdu — Actualizado por Bounded Context

left to right direction
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName Arial

' =========================
' AUTH
' =========================
package "auth" {
  entity "roles" as roles {
    *id : UUID <<PK>>
    --
    *name : VARCHAR(30) <<UQ>>
    description : VARCHAR(120)
  }

  entity "users" as users {
    *id : UUID <<PK>>
    --
    *first_name : VARCHAR(80)
    *last_name : VARCHAR(80)
    *email : VARCHAR(120) <<UQ>>
    *password_hash : VARCHAR(255)
    *provider : VARCHAR(20)
    *status : VARCHAR(20)
    *role_id : UUID <<FK>>
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
  }

  entity "password_reset_tokens" as password_reset_tokens {
    *id : UUID <<PK>>
    --
    *user_id : UUID <<FK>>
    *token : VARCHAR(255) <<UQ>>
    *expires_at : TIMESTAMP
    *used : BOOLEAN
    created_at : TIMESTAMP
  }

  entity "sessions" as sessions {
    *id : UUID <<PK>>
    --
    *user_id : UUID <<FK>>
    *refresh_token : VARCHAR(255) <<UQ>>
    *expires_at : TIMESTAMP
    revoked_at : TIMESTAMP
    created_at : TIMESTAMP
  }
}

' =========================
' PROFILE
' =========================
package "profile" {
  entity "profiles" as profiles {
    *id : UUID <<PK>>
    --
    *user_id : UUID <<FK, UQ>>
    *display_name : VARCHAR(120)
    avatar_url : TEXT
    city : VARCHAR(80)
    bio : TEXT
    *profile_type : VARCHAR(20)
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
  }

  entity "student_profiles" as student_profiles {
    *profile_id : UUID <<PK, FK>>
    --
    school_name : VARCHAR(120)
    grade_level : VARCHAR(20)
    target_university : VARCHAR(120)
    target_career : VARCHAR(120)
    study_shift : VARCHAR(30)
    target_exam_area_id : UUID <<FK>>
  }

  entity "teacher_profiles" as teacher_profiles {
    *profile_id : UUID <<PK, FK>>
    --
    specialty : VARCHAR(120)
    institution_name : VARCHAR(120)
    bio_professional : TEXT
  }

  entity "organization_profiles" as organization_profiles {
    *profile_id : UUID <<PK, FK>>
    --
    organization_name : VARCHAR(120)
    ruc : VARCHAR(20) <<UQ>>
    website : VARCHAR(255)
    contact_email : VARCHAR(120)
  }

  entity "notification_preferences" as notification_preferences {
    *user_id : UUID <<PK, FK>>
    --
    email_enabled : BOOLEAN
    in_app_enabled : BOOLEAN
    forum_enabled : BOOLEAN
    moderation_enabled : BOOLEAN
  }
}

' =========================
' ACADEMY
' =========================
package "academy" {
  entity "academies" as academies {
    *id : UUID <<PK>>
    --
    *owner_profile_id : UUID <<FK>>
    *name : VARCHAR(120)
    description : TEXT
    website : VARCHAR(255)
    email : VARCHAR(120)
    active : BOOLEAN
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
  }

  entity "campuses" as campuses {
    *id : UUID <<PK>>
    --
    *academy_id : UUID <<FK>>
    *name : VARCHAR(120)
    *address : VARCHAR(180)
    *city : VARCHAR(80)
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
  }

  entity "programs" as programs {
    *id : UUID <<PK>>
    --
    *academy_id : UUID <<FK>>
    *name : VARCHAR(120)
    *modality : VARCHAR(30)
    *intensity : VARCHAR(30)
    *target_university : VARCHAR(120)
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
  }

  entity "cycles" as cycles {
    *id : UUID <<PK>>
    --
    *academy_id : UUID <<FK>>
    *name : VARCHAR(120)
    *cycle_type : VARCHAR(30)
    *start_date : DATE
    *end_date : DATE
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
  }

  entity "teacher_academies" as teacher_academies {
    *teacher_profile_id : UUID <<PK, FK>>
    *academy_id : UUID <<PK, FK>>
    created_at : TIMESTAMP
  }
}

' =========================
' LIBRARY
' =========================
package "library" {
  entity "institutions" as institutions {
    *id : UUID <<PK>>
    --
    *name : VARCHAR(120) <<UQ>>
    city : VARCHAR(80)
  }

  entity "exam_areas" as exam_areas {
    *id : UUID <<PK>>
    --
    *institution_id : UUID <<FK>>
    *code : VARCHAR(10)
    *name : VARCHAR(120)
    *admission_modality : VARCHAR(30)
    description : TEXT
    *active : BOOLEAN
    created_at : TIMESTAMP
    <<UNIQUE (institution_id, code, admission_modality)>>
  }

  entity "area_subjects" as area_subjects {
    *id : UUID <<PK>>
    --
    *exam_area_id : UUID <<FK>>
    *subject_id : UUID <<FK>>
    *weight_percentage : DECIMAL(5,2)
    *is_eliminatory : BOOLEAN
    min_score : DECIMAL(4,2)
    <<UNIQUE (exam_area_id, subject_id)>>
  }

  entity "subjects" as subjects {
    *id : UUID <<PK>>
    --
    *name : VARCHAR(80) <<UQ>>
  }

  entity "tags" as tags {
    *id : UUID <<PK>>
    --
    *name : VARCHAR(60) <<UQ>>
  }

  entity "resource_files" as resource_files {
    *id : UUID <<PK>>
    --
    *file_url : TEXT
    *file_name : VARCHAR(255)
    mime_type : VARCHAR(80)
    size_bytes : BIGINT
    created_at : TIMESTAMP
  }

  entity "academic_resources" as academic_resources {
    *id : UUID <<PK>>
    --
    *author_user_id : UUID <<FK>>
    subject_id : UUID <<FK>>
    institution_id : UUID <<FK>>
    exam_area_id : UUID <<FK>>
    file_id : UUID <<FK>>
    *title : VARCHAR(160)
    description : TEXT
    *resource_type : VARCHAR(30)
    *visibility : VARCHAR(20)
    exam_year : INT
    exam_cycle : VARCHAR(30)
    *allows_solutions : BOOLEAN
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
  }

  entity "resource_solutions" as resource_solutions {
    *id : UUID <<PK>>
    --
    *resource_id : UUID <<FK>>
    *student_id : UUID <<FK>>
    *file_id : UUID <<FK>>
    *status : VARCHAR(20)
    submitted_at : TIMESTAMP
    <<UNIQUE (resource_id, student_id)>>
  }

  entity "resource_tags" as resource_tags {
    *resource_id : UUID <<PK, FK>>
    *tag_id : UUID <<PK, FK>>
    created_at : TIMESTAMP
  }

  entity "download_logs" as download_logs {
    *id : UUID <<PK>>
    --
    *user_id : UUID <<FK>>
    *resource_id : UUID <<FK>>
    *downloaded_at : TIMESTAMP
  }
}

' =========================
' FORUM
' =========================
package "forum" {
  entity "threads" as threads {
    *id : UUID <<PK>>
    --
    *author_user_id : UUID <<FK>>
    *subject_id : UUID <<FK>>
    *title : VARCHAR(160)
    *body : TEXT
    *is_anonymous : BOOLEAN
    *status : VARCHAR(20)
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
  }

  entity "answers" as answers {
    *id : UUID <<PK>>
    --
    *thread_id : UUID <<FK>>
    *author_user_id : UUID <<FK>>
    *body : TEXT
    *is_accepted : BOOLEAN
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
  }

  entity "comments" as comments {
    *id : UUID <<PK>>
    --
    *thread_id : UUID <<FK>>
    answer_id : UUID <<FK>>
    *author_user_id : UUID <<FK>>
    *body : TEXT
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
  }

  entity "follow_relations" as follow_relations {
    *id : UUID <<PK>>
    --
    *follower_user_id : UUID <<FK>>
    *followed_user_id : UUID <<FK>>
    created_at : TIMESTAMP
  }

  entity "reactions" as reactions {
    *id : UUID <<PK>>
    --
    *user_id : UUID <<FK>>
    thread_id : UUID <<FK>>
    answer_id : UUID <<FK>>
    comment_id : UUID <<FK>>
    *reaction_type : VARCHAR(20)
    created_at : TIMESTAMP
  }
}

' =========================
' GAMIFICATION
' =========================
package "gamification" {
  entity "coin_wallets" as coin_wallets {
    *user_id : UUID <<PK, FK>>
    --
    *balance : INT
    updated_at : TIMESTAMP
  }

  entity "point_transactions" as point_transactions {
    *id : UUID <<PK>>
    --
    *user_id : UUID <<FK>>
    *source_type : VARCHAR(30)
    source_id : UUID
    *points_delta : INT
    *reason : VARCHAR(120)
    created_at : TIMESTAMP
  }

  entity "badges" as badges {
    *id : UUID <<PK>>
    --
    *code : VARCHAR(40) <<UQ>>
    *name : VARCHAR(80)
    description : TEXT
  }

  entity "user_badges" as user_badges {
    *user_id : UUID <<PK, FK>>
    *badge_id : UUID <<PK, FK>>
    earned_at : TIMESTAMP
  }

  entity "level_progress" as level_progress {
    *user_id : UUID <<PK, FK>>
    --
    *current_level : INT
    *experience : INT
    *progress_percentage : DECIMAL(5,2)
    updated_at : TIMESTAMP
  }
}

' =========================
' MODERATION
' =========================
package "moderation" {
  entity "reports" as reports {
    *id : UUID <<PK>>
    --
    *reporter_user_id : UUID <<FK>>
    *target_type : VARCHAR(30)
    *target_id : UUID
    *reason : VARCHAR(200)
    *status : VARCHAR(20)
    resolved_by : UUID <<FK>>
    created_at : TIMESTAMP
    resolved_at : TIMESTAMP
  }

  entity "moderation_actions" as moderation_actions {
    *id : UUID <<PK>>
    --
    *report_id : UUID <<FK>>
    *moderator_user_id : UUID <<FK>>
    *action_type : VARCHAR(30)
    notes : TEXT
    created_at : TIMESTAMP
  }

  entity "audit_logs" as audit_logs {
    *id : UUID <<PK>>
    --
    *actor_user_id : UUID <<FK>>
    *action_type : VARCHAR(50)
    *entity_type : VARCHAR(50)
    *entity_id : UUID
    detail : TEXT
    created_at : TIMESTAMP
  }

  entity "appeals" as appeals {
    *id : UUID <<PK>>
    --
    *report_id : UUID <<FK>>
    *user_id : UUID <<FK>>
    *reason : TEXT
    *status : VARCHAR(20)
    created_at : TIMESTAMP
    reviewed_at : TIMESTAMP
  }
}

' =========================
' VERIFICATION
' =========================
package "verification" {
  entity "verification_requests" as verification_requests {
    *id : UUID <<PK>>
    --
    *user_id : UUID <<FK>>
    *entity_type : VARCHAR(20)
    *status : VARCHAR(20)
    submitted_at : TIMESTAMP
    reviewed_by : UUID <<FK>>
    reviewed_at : TIMESTAMP
  }

  entity "verification_documents" as verification_documents {
    *id : UUID <<PK>>
    --
    *request_id : UUID <<FK>>
    *document_type : VARCHAR(50)
    *file_url : TEXT
    uploaded_at : TIMESTAMP
  }
}

' =========================
' BILLING
' =========================
package "billing" {
  entity "plans" as plans {
    *id : UUID <<PK>>
    --
    *name : VARCHAR(40) <<UQ>>
    *price : DECIMAL(10,2)
    *duration_days : INT
    *description : VARCHAR(200)
  }

  entity "subscriptions" as subscriptions {
    *id : UUID <<PK>>
    --
    *user_id : UUID <<FK>>
    *plan_id : UUID <<FK>>
    *status : VARCHAR(20)
    starts_at : TIMESTAMP
    ends_at : TIMESTAMP
    created_at : TIMESTAMP
  }

  entity "payments" as payments {
    *id : UUID <<PK>>
    --
    *user_id : UUID <<FK>>
    subscription_id : UUID <<FK>>
    coin_purchase_id : UUID <<FK>>
    *amount : DECIMAL(10,2)
    *currency : VARCHAR(10)
    *payment_method : VARCHAR(30)
    *status : VARCHAR(20)
    created_at : TIMESTAMP
  }

  entity "coin_packages" as coin_packages {
    *id : UUID <<PK>>
    --
    *name : VARCHAR(60)
    *coins : INT
    *price : DECIMAL(10,2)
    active : BOOLEAN
  }

  entity "coin_purchases" as coin_purchases {
    *id : UUID <<PK>>
    --
    *user_id : UUID <<FK>>
    *coin_package_id : UUID <<FK>>
    *quantity : INT
    *total_amount : DECIMAL(10,2)
    *status : VARCHAR(20)
    created_at : TIMESTAMP
  }

  entity "premium_access" as premium_access {
    *id : UUID <<PK>>
    --
    *user_id : UUID <<FK>>
    *granted_at : TIMESTAMP
    *expires_at : TIMESTAMP
    revoked_at : TIMESTAMP
  }
}

' =========================
' FEEDBACK
' =========================
package "feedback" {
  entity "feedback_entries" as feedback_entries {
    *id : UUID <<PK>>
    --
    *author_user_id : UUID <<FK>>
    *target_user_id : UUID <<FK>>
    program_id : UUID <<FK>>
    cycle_id : UUID <<FK>>
    solution_id : UUID <<FK>>
    resource_id : UUID <<FK>>
    *body : TEXT
    score : DECIMAL(4,2)
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
  }
}

' =========================
' NOTIFICATIONS
' =========================
package "notifications" {
  entity "notifications" as notifications {
    *id : UUID <<PK>>
    --
    *user_id : UUID <<FK>>
    *type : VARCHAR(30)
    *title : VARCHAR(120)
    *message : TEXT
    read_at : TIMESTAMP
    created_at : TIMESTAMP
  }
}

