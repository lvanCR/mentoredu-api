{
  "name": "MentorEduBillingHU23-ActivarSuscripcionPOST",
  "description": "Caso 03 — Alternativo exitoso: plan TRIMESTRAL válido, cuenta con acceso premium activo. Espera 201 Created.",
  "request": {
    "method": "POST",
    "url": "{{api_v1}}/billing/subscriptions",
    "header": [
      { "key": "Authorization", "value": "Bearer {{access_token}}" },
      { "key": "Content-Type",  "value": "application/json" }
    ],
    "body": {
      "planId": "{{plan_trimestral_id}}",
      "paymentMethod": "CARD"
    }
  },
  "expectedResponse": {
    "status": 201,
    "body": {
      "planName": "TRIMESTRAL",
      "status": "ACTIVE"
    }
  }
