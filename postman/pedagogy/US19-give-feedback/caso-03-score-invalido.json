{
  "name": "MentorEduPedagogyUS19-GiveFeedbackInvalidScorePOST",
  "description": "Caso 03 — Score inválido: valor fuera del rango 0.0-10.0. Espera 400 Bad Request (RN-22).",
  "request": {
    "method": "POST",
    "url": "{{api_v1}}/solutions/{{solution_id}}/feedback",
