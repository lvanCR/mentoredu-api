{
  "name": "US19-GiveFeedback-ScoreInvalido",
  "description": "Caso 03 — Score fuera de rango (> 10.0). Espera 400 Bad Request (RN-22).",
  "request": {
    "method": "POST",
    "url": "{{api_v1}}/solutions/{{solution_id}}/feedback",
    "header": [
      { "key": "Authorization", "value": "Bearer {{teacher_token}}" },
      { "key": "Content-Type", "value": "application/json" }
    ],
    "body": {
      "mode": "raw",
      "raw": "{\n  \"score\": 11.0,\n  \"body\": \"Score fuera de rango permitido.\"\n}"
    }
  },
  "expectedResponse": {
    "status": 400
  }
}
