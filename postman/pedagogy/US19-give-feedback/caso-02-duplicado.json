{
  "name": "US19-GiveFeedback-Duplicado",
  "description": "Caso 02 — Duplicado: ya existe feedback para esta solución (RN-11). Espera 409 Conflict.",
  "request": {
    "method": "POST",
    "url": "{{api_v1}}/solutions/{{solution_id}}/feedback",
    "header": [
      { "key": "Authorization", "value": "Bearer {{teacher_token}}" },
      { "key": "Content-Type", "value": "application/json" }
    ],
    "body": {
      "mode": "raw",
      "raw": "{\n  \"score\": 7.0,\n  \"body\": \"Intento de sobreescribir feedback existente.\"\n}"
    }
  },
  "expectedResponse": {
    "status": 409
  }
}
