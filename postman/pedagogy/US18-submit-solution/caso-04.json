{
  "description": "US39 — Error: recurso no existe",
  "scenario": "Dado que el resourceId no corresponde a ningún recurso registrado, cuando el estudiante intenta enviar la resolución, entonces el sistema responde con 404 Not Found.",
  "request": {
    "method": "POST",
    "url": "{{api_v1}}/resources/00000000-0000-0000-0000-000000000000/solutions",
    "headers": {
      "Authorization": "Bearer {{student_token}}",
      "Content-Type": "application/json"
    },
    "body": {
      "fileId": "{{fileId}}"
    }
  },
  "expected_response": {
    "status": 404,
    "body": {
      "status": 404,
      "error": "Not Found",
      "message": "Recurso no encontrado: 00000000-0000-0000-0000-000000000000"
    }
  }
}
