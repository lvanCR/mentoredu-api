{
  "description": "US18 — Caso 04: recurso no existe.",
  "scenario": "Dado que el resourceId no corresponde a ningún recurso registrado, cuando el estudiante intenta enviar la resolución, entonces el sistema responde 404 Not Found.",
  "request": {
    "method": "POST",
    "url": "{{api_v1}}/resources/00000000-0000-0000-0000-000000000000/solutions",
    "headers": {
      "Authorization": "Bearer {{student_token}}",
      "Content-Type": "application/json"
    },
    "body": {
      "fileUrl": "{{file_url}}"
    }
  },
  "expected_response": {
    "status": 404
  }
}
