{
  "name": "MentorEduPedagogyUS17-ViewSolutionsGET",
  "description": "Caso 01 — Exitoso: docente lista las resoluciones enviadas a su ejercicio. Espera 200 OK con array de soluciones.",
  "request": {
    "method": "GET",
    "url": "{{api_v1}}/resources/{{resource_id}}/solutions",
    "header": [
      { "key": "Authorization", "value": "Bearer {{teacher_token}}" }
    ]
  },
  "expectedResponse": {
    "status": 200,
    "body": [
      {
        "solutionId": "<uuid>",
        "resourceId": "{{resource_id}}",
        "studentId": "<uuid>",
        "fileUrl": "<string>",
        "content": "<string|null>",
        "status": "SUBMITTED",
        "submittedAt": "<timestamp>",
        "feedback": null
      }
    ]
  }
}
