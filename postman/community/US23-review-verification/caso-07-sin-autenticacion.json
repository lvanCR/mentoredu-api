{
  "name": "MentorEduCommunityUS23-ReviewVerificationNoAuthPATCH",
  "description": "Caso 07 — Error: sin token JWT. Espera 401 Unauthorized.",
  "request": {
    "method": "PATCH",
    "url": "{{api_v1}}/verification/requests/{{verification_id}}/review",
    "header": [
      { "key": "Content-Type", "value": "application/json" }
    ],
    "body": {
      "mode": "raw",
      "raw": "{\n  \"action\": \"APPROVED\"\n}"
    }
  },
  "expectedResponse": {
    "status": 401,
    "description": "Unauthorized. Se requiere autenticación JWT.",
    "body": {
      "status": 401,
      "error": "Unauthorized",
      "message": "Autenticación requerida."
    }
  }
}
