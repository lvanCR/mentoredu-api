{
  "name": "MentorEduFeedbackHU34-ProvideFeedbackTargetNotFoundPOST",
  "scenario": "Alternativo error — estudiante objetivo no existe → 404 Not Found",
  "request": {
    "method": "POST",
    "url": "{{api_v1}}/feedback",
    "headers": {
      "Authorization": "Bearer {{teacher_token}}",
      "Content-Type": "application/json"
    },
    "body": {
      "targetUserId": "00000000-0000-0000-0000-000000000000",
      "body": "Retroalimentación hacia un estudiante inexistente."
    }
  },
  "expected_response": {
    "status": 404,
    "body": {
      "error": "Not Found",
      "message": "Estudiante no encontrado: 00000000-0000-0000-0000-000000000000"
    }
  }
}
