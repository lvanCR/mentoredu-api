{
  "name": "MentorEduFeedbackHU34-ProvideFeedbackWithScorePOST",
  "scenario": "Alternativo exitoso — incluye puntuación → 201 Created con score guardado",
  "request": {
    "method": "POST",
    "url": "{{api_v1}}/feedback",
    "headers": {
      "Authorization": "Bearer {{teacher_token}}",
      "Content-Type": "application/json"
    },
    "body": {
      "targetUserId": "{{target_user_id}}",
      "body": "Excelente participación y dominio del tema. Sigue así.",
      "score": 17.5,
      "programId": "{{program_id}}",
      "cycleId": "{{cycle_id}}"
    }
  },
  "expected_response": {
    "status": 201,
    "body": {
      "id": "<UUID generado>",
      "authorUserId": "<UUID del docente autenticado>",
      "targetUserId": "{{target_user_id}}",
      "body": "Excelente participación y dominio del tema. Sigue así.",
      "score": 17.5,
      "programId": "{{program_id}}",
      "cycleId": "{{cycle_id}}",
      "createdAt": "<timestamp>"
    }
  }
}
