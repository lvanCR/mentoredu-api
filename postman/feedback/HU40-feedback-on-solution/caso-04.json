{
  "description": "US40 — Error: resolución no existe",
  "scenario": "Dado que el solutionId no corresponde a ninguna resolución registrada, cuando el docente intenta registrar feedback, entonces el sistema responde con 404 Not Found.",
  "request": {
    "method": "POST",
    "url": "{{api_v1}}/feedback",
    "headers": {
      "Authorization": "Bearer {{teacher_token}}",
      "Content-Type": "application/json"
    },
    "body": {
      "targetUserId": "{{student_id}}",
      "solutionId": "00000000-0000-0000-0000-000000000000",
      "body": "Feedback con solución inexistente.",
      "score": 6.0
    }
  },
  "expected_response": {
    "status": 404,
    "body": {
      "status": 404,
      "error": "Not Found",
      "message": "Resolución no encontrada: 00000000-0000-0000-0000-000000000000"
    }
  }
}
