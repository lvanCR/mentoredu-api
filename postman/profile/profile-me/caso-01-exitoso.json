{
  "name": "MentorEduProfileHU05-UpdateProfilePATCH",
  "request": {
    "method": "PATCH",
    "header": [
      { "key": "Content-Type", "value": "application/json" },
      { "key": "Authorization", "value": "Bearer {{access_token}}" }
    ],
    "url": { "raw": "{{api_v1}}/profiles/me" },
    "body": {
      "mode": "raw",
      "raw": "{\n  \"displayName\": \"Juan Pérez\",\n  \"avatarUrl\": \"https://example.com/avatar.png\",\n  \"city\": \"Lima\",\n  \"bio\": \"Estudiante preparándose para ingeniería.\"\n}"
    }
  },
  "response": {
    "status": 200,
    "description": "Perfil actualizado exitosamente. displayName, avatarUrl, city y bio se reflejan en la respuesta. profileType permanece sin cambios."
  }
}
