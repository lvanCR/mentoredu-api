{
  "scenario": "Exitoso — Cuenta ACADEMY, solo academyName enviado (campo obligatorio)",
  "gherkin": "Dado que mi cuenta fue clasificada como academia, cuando ingreso el nombre, entonces el sistema crea el perfil.",
  "request": {
    "method": "POST",
    "url": "{{api_v1}}/profiles/academy",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer {{academy_token}}"
    },
    "body": {
      "academyName": "Academia Preuniversitaria Lima"
    }
  },
  "expected_response": {
    "status": 201,
    "body": {
      "profileId": "<uuid>",
      "academyName": "Academia Preuniversitaria Lima",
      "ruc": null,
      "website": null,
      "contactEmail": null
    }
  }
}
