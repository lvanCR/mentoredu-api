{
  "name": "MentorEduLibraryUS07-SubirPdf413POST",
  "request": {
    "method": "POST",
    "header": [
      {
        "key": "Authorization",
        "value": "Bearer {{access_token}}"
      }
    ],
    "body": {
      "mode": "formdata",
      "formdata": [
        {
          "key": "file",
          "type": "file",
          "src": "/path/to/archivo-mayor-20mb.pdf",
          "description": "PDF válido pero mayor a 20 MB"
        }
      ]
    },
    "url": {
      "raw": "{{api_v1}}/resources/files",
      "host": ["{{api_v1}}"],
      "path": ["resources", "files"]
    },
    "description": "Caso 03 — Error: PDF excede el límite de 20 MB → 413 Payload Too Large (MaxUploadSizeExceededException)."
  },
  "expectedResponse": {
    "status": 413,
    "body": {
      "timestamp": "<ISO timestamp>",
      "status": 413,
      "error": "Payload Too Large",
      "message": "El archivo supera el tamaño máximo permitido"
    }
  }
}
