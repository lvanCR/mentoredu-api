{
  "name": "US08-RegisterResource-ExamenCompleto",
  "description": "Caso 01 — Exitoso: registrar EXAMEN_COMPLETO con campos mínimos (sin courseId). Respuesta esperada: 201 Created.",
  "request": {
    "method": "POST",
    "url": "{{api_v1}}/resources",
    "header": [
      { "key": "Authorization", "value": "Bearer {{teacher_token}}" },
      { "key": "Content-Type",  "value": "application/json" }
    ],
    "body": {
      "mode": "raw",
      "raw": "{\n  \"title\": \"Examen de Admisión UNI 2024-I\",\n  \"universityId\": \"{{university_id}}\",\n  \"areaId\": \"{{area_id}}\",\n  \"resourceType\": \"EXAMEN_COMPLETO\",\n  \"fileUrl\": \"{{file_url}}\",\n  \"fileName\": \"{{file_name}}\",\n  \"mimeType\": \"{{mime_type}}\",\n  \"sizeBytes\": \"{{size_bytes}}\"\n}"
    }
  },
  "expectedResponse": {
    "status": 201,
    "fields": ["id", "title", "resourceType", "visibility", "universityId", "areaId", "fileUrl", "fileName", "mimeType", "sizeBytes", "createdAt", "authorId", "authorName"]
  }
}
