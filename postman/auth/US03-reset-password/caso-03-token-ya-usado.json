{
  "description": "Caso 3: Token ya utilizado en un reseteo previo",
  "notes": "Para simular: ejecutar caso-01 con un token válido y luego volver a intentar con el mismo token.",
  "request": {
    "method": "POST",
    "url": "{{api_v1}}/auth/reset-password",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "token": "<token_ya_utilizado>",
      "newPassword": "NewPassword456"
    }
  },
  "expected_response": {
    "status": 400,
    "body": {
      "status": 400,
      "error": "Bad Request",
      "message": "El token ya fue utilizado"
    }
  }
}
