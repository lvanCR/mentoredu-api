{
  "name": "MentorEduModerationHU19-ReportContentPOST",
  "description": "Caso 01 — Reporte exitoso de un hilo. Espera 201 Created con los datos del reporte registrado.",
  "request": {
    "method": "POST",
    "url": "{{api_v1}}/moderation/reports",
    "header": [
      {
        "key": "Authorization",
        "value": "Bearer {{access_token}}"
      },
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "body": {
      "targetType": "THREAD",
      "targetId": "{{thread_id}}",
      "reason": "Contenido inapropiado o spam"
    }
  },
  "expectedResponse": {
    "status": 201,
    "body": {
      "id": "<uuid>",
      "targetType": "THREAD",
      "targetId": "{{thread_id}}",
      "reason": "Contenido inapropiado o spam",
      "status": "OPEN",
      "createdAt": "<timestamp>"
    }
  }
}
